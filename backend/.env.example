# AquaShield AI — Environment Variables
# Copy this to .env and fill in your actual values

# ─── Application ───────────────────────────────────────────
APP_NAME=AquaShield AI
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=aquashield-super-secret-key-change-in-production-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/aquashield_db
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/aquashield_db

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── File Storage ──────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ─── External APIs ─────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key_here
IMD_API_KEY=your_imd_api_key_here
INCOIS_API_KEY=your_incois_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── AI / LLM ──────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ─── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
